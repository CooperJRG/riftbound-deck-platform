# Copy to .env only if you need to override a default. None of this is required.

# local  = single user, no login, loopback only (default)
# public = anonymous identity per browser, in a signed cookie; no login, but each
#          browser gets its own decks and collection. Needs RB_SECRET_KEY.
# hosted = requires a bearer-token provider (not yet implemented; fails closed)
RB_MODE=local

# Required by RB_MODE=public. Signs the per-browser identity cookie, so changing it
# makes every saved deck and collection unreachable. Generate once and keep it:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# RB_SECRET_KEY=

RB_PORT=8020
# RB_HOST=127.0.0.1        # local mode refuses any non-loopback host
# RB_DATA_DIR=./data       # must stay under the project root
# RB_DB_PATH=./data/riftbound.db

# TopDeck.gg API key — tournament results and decklists.
# Get one at https://topdeck.gg. Keep it here (.env is gitignored), never in source.
# RB_TOPDECK_API_KEY=
