# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.coverage

# Node / Vite
node_modules/
web/dist/
*.tsbuildinfo

# Local runtime state — never tracked (v2 committed its live user DB)
data/riftbound.db
data/riftbound.db-*
data/bundles/*
!data/bundles/.gitkeep

# Ingest working area — raw source responses are cache, not source code
var/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log

# Raw ingest responses — cache, not source
var/
data/meta/*
!data/meta/.gitkeep

# data/meta-seed/ is deliberately NOT ignored — one committed meta snapshot (manifest +
# decks), promoted into data/meta/ at start-up when nothing has been harvested yet. See
# Services.warm() / seed_meta_if_missing(). Refresh it occasionally with:
#   cp data/meta/$(cat data/meta/current.txt)/{manifest,meta}.json data/meta-seed/

# Browser-automation scratch from UI verification runs. Screenshots and traces are
# evidence for one session, not source.
output/
.playwright-cli/
