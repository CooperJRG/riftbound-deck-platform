# Everything the image does not need. The working tree carries 751 MB of data/ and a
# 743 MB meta archive; without this the build context alone would be most of a gigabyte
# and the layer cache would miss on every harvest.

.git
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.playwright-cli

# Harvest caches and logs: rebuildable, and large.
var/
logs/
output/

# Card and meta data are volume state, not image content. `data/rules`, `data/seed` and
# `data/meta-seed` are copied explicitly in the Dockerfile: the first two are small and
# needed to boot, and `data/meta-seed` is the committed meta snapshot that lets a fresh
# deploy render Explore immediately instead of waiting on a ~25-minute cold harvest.
data/
!data/rules/
!data/seed/
!data/meta-seed/

web/node_modules
web/dist
node_modules

.env
.env.*
!.env.example
